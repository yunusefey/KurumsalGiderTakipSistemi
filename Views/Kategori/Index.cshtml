@model IEnumerable<KurumsalGiderTakipSistemi.Models.HarcamaKategori>

@{
    ViewData["Title"] = "Kategori & Limit Yönetimi";
}

<div class="row">
    <!-- Sol: Yeni Kategori Ekleme Formu -->
    <div class="col-md-4">
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0">Yeni Kategori Ekle</h5>
            </div>
            <div class="card-body">
                <form asp-action="Ekle" method="post">
                    <div class="mb-3">
                        <label class="form-label">Kategori Adı</label>
                        <input type="text" name="ad" class="form-control" placeholder="Örn: Yazılım Lisansları" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Maksimum Harcama Limiti (TL)</label>
                        <input type="number" step="0.01" name="maxLimit" class="form-control" placeholder="Opsiyonel (Örn: 1500)" />
                        <div class="form-text">Boş bırakırsanız limit uygulanmaz.</div>
                    </div>

                    <button type="submit" class="btn btn-primary w-100">Kategori Kaydet</button>
                </form>
            </div>
        </div>
    </div>

    <!-- Sağ: Kategori Listesi -->
    <div class="col-md-8">
        <div class="card">
            <h5 class="card-header">Tanımlı Harcama Kategorileri</h5>
            <div class="table-responsive text-nowrap">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Kategori Adı</th>
                            <th>Maksimum Limit</th>
                            <th>Toplam Harcama Adedi</th>
                            <th class="text-center">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="4" class="text-center py-4 text-muted">Henüz kayıtlı kategori bulunmuyor.</td>
                            </tr>
                        }
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td><strong>@item.Ad</strong></td>
                                <td>
                                    @if (item.MaxLimit.HasValue)
                                    {
                                        <span class="badge bg-label-warning fs-7">@item.MaxLimit.Value.ToString("C2")</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Limitsiz</span>
                                    }
                                </td>
                                <td><span class="badge bg-label-info">@(item.Harcamalar?.Count ?? 0) Adet</span></td>
                                <td class="text-center">
                                    <form asp-action="Sil" method="post" class="d-inline">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Bu kategoriyi silmek istediğinize emin misiniz?');">
                                            <i class="bx bx-trash"></i> Sil
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>