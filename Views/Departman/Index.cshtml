@model IEnumerable<KurumsalGiderTakipSistemi.Models.Departman>

@{
    ViewData["Title"] = "Departman Yönetimi";
}

<div class="row">
    <!-- Sol Taraf: Yeni Departman Ekleme Formu -->
    <div class="col-md-4">
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0">Yeni Departman Ekle</h5>
            </div>
            <div class="card-body">
                <form asp-action="Ekle" method="post">
                    <div class="mb-3">
                        <label class="form-label">Departman Adı</label>
                        <input type="text" name="ad" class="form-control" placeholder="Örn: Bilgi İşlem, İK..." required />
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Departman Kaydet</button>
                </form>
            </div>
        </div>
    </div>

    <!-- Sağ Taraf: Departman Listesi -->
    <div class="col-md-8">
        <div class="card">
            <h5 class="card-header">Şirket Departmanları</h5>
            <div class="table-responsive text-nowrap">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Departman Adı</th>
                            <th>Çalışan Sayısı</th>
                            <th class="text-center">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="4" class="text-center py-4 text-muted">Henüz kayıtlı bir departman bulunmuyor.</td>
                            </tr>
                        }
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Id</td>
                                <td><strong>@item.Ad</strong></td>
                                <td><span class="badge bg-label-info">@(item.Kullanicilar?.Count ?? 0) Çalışan</span></td>
                                <td class="text-center">
                                    <form asp-action="Sil" method="post" class="d-inline">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Bu departmanı silmek istediğinize emin misiniz?');">
                                            <i class="bx bx-trash"></i> Sil
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>